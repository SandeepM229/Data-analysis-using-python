def is_sorted(l): 
    f=0 
    i=1 
    while i<len(l): 
        if l[i]<l[i-1]: 
            f=1 
        i+=1 
    if not f: 
        return True 
    else: 
        return False 
l=[] 
n=int(input("enter list size:")) 
for i in range(0,n): 
    el=int(input()) 
    l.append(el) 
print(is_sorted(l))
